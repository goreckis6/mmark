# Skopiuj do .env i uzupełnij lokalnie (NIE commituj .env)

AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=eu.anthropic.claude-opus-4-8
PORT=8787

# Publiczna domena (Hostinger) — używane m.in. w /health i proxy newsów
PUBLIC_SITE_URL=https://rekinybiznesu.shop

# Pierwsze konto admin (tworzone automatycznie gdy baza pusta)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zmien_mnie

# Dodatkowe konta przy starcie serwera (Hostinger: ustaw w Environment variables)
# Format: login:haslo,login2:haslo2
# BOOTSTRAP_USERS=rekinybiznesu:twoje_haslo

# Opcjonalnie — tylko jeśli nie masz IAM role na serwerze
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Opcjonalnie — lepszy research przed generacją bloga (anty-halucynacje)
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=

# Thumbnails: w Frankfurt NIE ma modelu image — domyślnie SVG przez Claude (eu.anthropic…)
BEDROCK_IMAGE_ENGINE=svg
# Opcjonalnie raster poza Frankfurt (np. Nova Canvas Ireland — często Legacy):
# BEDROCK_IMAGE_ENGINE=raster
# BEDROCK_IMAGE_REGION=eu-west-1
# BEDROCK_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0

# Scraper Useme — osobny panel: /scraper
SCRAPER_ENABLED=true
SCRAPER_PASSWORD="ustaw_osobne_haslo"
SCRAPER_INTERVAL_MINUTES=5
SCRAPER_MAX_PAGES=10
# Useme robots.txt wskazuje crawl-delay 10 sekund
SCRAPER_PAGE_DELAY_SECONDS=10
SCRAPER_EMAIL_TO=slavomir.gorecki@gmail.com
# USEME_SOURCE_URL=https://useme.com/pl/jobs/category/serwisy-internetowe,34/

# Skrzynka nadawcza (Hostinger Email lub inny SMTP z SSL na porcie 465)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=scraper@rekinybiznesu.shop
# SMTP_PASS=
# SMTP_FROM=scraper@rekinybiznesu.shop
